---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArchivePage from "../../../components/ArchivePage.astro";
import { getSortedPosts } from "../../../content-utils";
import { SITE_TITLE } from "../../../consts";

const posts = await getSortedPosts("en");
---

<BaseLayout title={`Archive · ${SITE_TITLE}`} description="All blog posts" locale="en">
  <ArchivePage locale="en" posts={posts} />
</BaseLayout>
