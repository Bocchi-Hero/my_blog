---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/HomePage.astro";
import { getSortedPosts } from "../../content-utils";
import { SITE_DESCRIPTION_EN, SITE_TITLE } from "../../consts";

const posts = await getSortedPosts("en");
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION_EN} locale="en">
  <HomePage locale="en" posts={posts} />
</BaseLayout>
