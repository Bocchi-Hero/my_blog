---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchivePage from "../../components/ArchivePage.astro";
import { getSortedPosts } from "../../content-utils";
import { SITE_TITLE } from "../../consts";

const posts = await getSortedPosts("zh");
---

<BaseLayout title={`全部文章 · ${SITE_TITLE}`} description="所有博客文章列表" locale="zh">
  <ArchivePage locale="zh" posts={posts} />
</BaseLayout>
