---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getLocalizedPostDescription, getLocalizedPostTags, getLocalizedPostTitle } from "../../content-utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const words = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / 220));
const { Content, headings } = await render(post);
---

<BlogPost
  title={getLocalizedPostTitle(post, "zh")}
  description={getLocalizedPostDescription(post, "zh")}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.heroImage}
  tags={getLocalizedPostTags(post, "zh")}
  readingTime={readingTime}
  locale="zh"
  headings={headings}
>
  <Content />
</BlogPost>
