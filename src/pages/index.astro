---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomePage from "../components/HomePage.astro";
import { getSortedPosts } from "../content-utils";
import { SITE_DESCRIPTION_ZH, SITE_TITLE } from "../consts";

const posts = await getSortedPosts("zh");
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION_ZH} locale="zh">
  <HomePage locale="zh" posts={posts} />
</BaseLayout>
