---
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import type { BlogPostEntry } from "../content-utils";
import { getPostSlug, slugifyTag } from "../content-utils";
import { localePath, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  readingTime?: number;
  locale?: Locale;
  headings?: { depth: number; slug: string; text: string }[];
  previousPost?: BlogPostEntry;
  nextPost?: BlogPostEntry;
  relatedPosts?: BlogPostEntry[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  readingTime,
  locale = "zh",
  headings = [],
  previousPost,
  nextPost,
  relatedPosts = [],
} = Astro.props;

const copy = locale === "zh"
  ? {
      back: "返回文章归档",
      eyebrow: "文章",
      readTime: (minutes: number) => `· 约 ${minutes} 分钟阅读`,
      updated: "更新于",
      originalNotice: "",
      tocTitle: "目录",
      relatedTitle: "继续阅读",
      previous: "上一篇",
      next: "下一篇",
      backToTop: "回到顶部",
    }
  : {
      back: "Back to archive",
      eyebrow: "Essay",
      readTime: (minutes: number) => `· ${minutes} min read`,
      updated: "Updated on",
      originalNotice: "",
      tocTitle: "Contents",
      relatedTitle: "Keep reading",
      previous: "Previous",
      next: "Next",
      backToTop: "Back to top",
    };
---

<BaseLayout title={title} description={description} ogImage={heroImage} ogType="article" locale={locale}>
  <article class="blog-post" data-post-page>
    <div class="reading-progress" aria-hidden="true">
      <div class="reading-progress-bar" data-reading-progress></div>
    </div>

    <div class="reading-status meta" data-reading-status>
      <span data-reading-progress-label>0%</span>
    </div>

    <a href={localePath(locale, "/blog/")} class="back-link">{copy.back}</a>

    <div class:list={["article-layout", { "with-toc": headings.length > 0 }]}>
      {headings.length > 0 && (
        <aside class="toc-sidebar">
          <nav class="article-toc" aria-label={copy.tocTitle}>
            <h2>{copy.tocTitle}</h2>
            <ul>
              {headings.map((heading) => (
                <li class:list={[`depth-${heading.depth}`]}>
                  <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <div class="article-main">
        <header class="article-header">
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>
          <div class="article-meta meta">
            <FormattedDate date={pubDate} locale={locale} />
            {typeof readingTime === "number" && <span>{copy.readTime(readingTime)}</span>}
            {updatedDate && (
              <span>
                ({copy.updated} <FormattedDate date={updatedDate} locale={locale} />)
              </span>
            )}
          </div>
          {copy.originalNotice && <p class="article-note">{copy.originalNotice}</p>}
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.map((tag) => (
                <a href={localePath(locale, `/tags/${slugifyTag(tag)}/`)} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </header>

        {heroImage && <img src={heroImage} alt={title} class="hero-image" />}

        <div class="article-body">
          <slot />
        </div>

        {(previousPost || nextPost) && (
          <nav class="post-pagination" aria-label={copy.relatedTitle}>
            {nextPost ? (
              <a href={localePath(locale, `/blog/${getPostSlug(nextPost)}/`)} class="pagination-link">
                <span>{copy.next}</span>
                <strong>{nextPost.data.title}</strong>
              </a>
            ) : (
              <div class="pagination-link empty"></div>
            )}

            {previousPost ? (
              <a href={localePath(locale, `/blog/${getPostSlug(previousPost)}/`)} class="pagination-link align-right">
                <span>{copy.previous}</span>
                <strong>{previousPost.data.title}</strong>
              </a>
            ) : (
              <div class="pagination-link empty"></div>
            )}
          </nav>
        )}

        {relatedPosts.length > 0 && (
          <section class="related-posts" aria-labelledby="related-posts-heading">
            <div class="section-meta">
              <h2 id="related-posts-heading">{copy.relatedTitle}</h2>
              <a href="#top" class="back-top" data-back-top>{copy.backToTop}</a>
            </div>
            <div class="related-list">
              {relatedPosts.map((post) => (
                <a href={localePath(locale, `/blog/${getPostSlug(post)}/`)} class="related-card">
                  <strong>{post.data.title}</strong>
                  <span>{post.data.description}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>

    <div class="image-lightbox" data-lightbox hidden>
      <button type="button" class="lightbox-close" data-lightbox-close aria-label={locale === "zh" ? "关闭图片预览" : "Close image preview"}>
        {locale === "zh" ? "关闭" : "Close"}
      </button>
      <img src="" alt="" class="lightbox-image" data-lightbox-image />
      <p class="lightbox-caption" data-lightbox-caption></p>
    </div>
  </article>
</BaseLayout>

<script>
  import { initPostReading } from "../scripts/post-reading";

  initPostReading();
</script>

<style>
  :global(html) {
    scroll-padding-top: 100px;
  }

  :global(main) {
    max-width: min(1720px, calc(100vw - 48px));
  }

  .blog-post {
    max-width: none;
    margin: 0 auto;
  }

  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: rgba(250, 250, 248, 0.74);
    backdrop-filter: blur(6px);
    z-index: 40;
  }

  .reading-progress-bar {
    width: 0%;
    height: 100%;
    background:
      linear-gradient(90deg, rgba(204, 120, 92, 0.85), rgba(169, 111, 83, 0.98));
    box-shadow: 0 0 18px rgba(204, 120, 92, 0.35);
    transition: width 0.12s ease-out;
  }

  .reading-status {
    position: fixed;
    top: 18px;
    right: 20px;
    z-index: 30;
    min-width: 72px;
    padding: 7px 12px;
    border: 1px solid rgba(28, 27, 24, 0.08);
    border-radius: 999px;
    background: rgba(250, 250, 248, 0.88);
    box-shadow: 0 10px 30px rgba(26, 26, 24, 0.08);
    backdrop-filter: blur(10px);
    text-align: center;
  }

  .article-layout {
    max-width: 1040px;
    margin: 0 auto;
  }

  .article-layout.with-toc {
    max-width: min(1500px, 100%);
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: 20px;
    justify-content: center;
    align-items: start;
  }

  .article-main {
    grid-column: 2;
    min-width: 0;
    max-width: 1120px;
    width: 100%;
  }

  .toc-sidebar {
    grid-column: 1;
    justify-self: start;
    width: 100%;
    min-width: 240px;
    position: sticky;
    top: 108px;
    align-self: start;
    max-height: none;
    overflow: visible;
    padding: 8px 2px 16px 0;
    transform: translateX(0px);
  }

  .back-link {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--text-primary);
  }

  .article-header {
    padding: 60px 0 40px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 48px;
  }

  .article-title {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
    margin-bottom: 16px;
  }

  .article-description {
    margin-bottom: 14px;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .article-note {
    margin-top: 12px;
    margin-bottom: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .article-tags {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hero-image {
    margin-bottom: 32px;
    cursor: zoom-in;
  }

  .article-toc {
    margin-top: 132px;
    padding: 10px 0 16px 20px;
    width: 100%;
    min-width: 240px;
    max-width: 280px;
    border-left: 1px solid var(--border);
    writing-mode: horizontal-tb;
    text-orientation: mixed;
  }

  .article-toc h2 {
    font-size: 1rem;
    margin: 0 0 10px;
  }

  .article-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .article-toc li.depth-3 {
    padding-left: 12px;
  }

  .article-toc li.depth-4 {
    padding-left: 24px;
  }

  .article-toc a {
    display: block;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.45;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: keep-all;
    line-break: strict;
    writing-mode: horizontal-tb;
    text-orientation: mixed;
    padding: 2px 0;
  }

  .article-toc a:hover {
    color: var(--text-primary);
  }

  .article-toc a.active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .article-body {
    font-size: 1rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .article-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: var(--accent-underline);
    text-underline-offset: 3px;
  }

  .article-body :global(a:hover) {
    text-decoration-color: var(--accent);
  }

  .article-body :global(blockquote) {
    border-left: 2px solid var(--border-hover);
    margin: 2rem 0;
    padding: 0 0 0 24px;
    color: var(--text-secondary);
  }

  .article-body :global(code) {
    font-family: var(--font-body);
    font-size: 0.85em;
    background: var(--bg-hover);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .article-body :global(pre) {
    background: var(--bg-hover);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 20px 24px;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .article-body :global(pre.enhanced-code) {
    position: relative;
    padding-top: 30px;
  }

  .article-body :global(.copy-code-button) {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 22px;
    height: 22px;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: rgba(92, 91, 86, 0.7);
    padding: 0;
    display: inline-grid;
    place-items: center;
    cursor: pointer;
    box-shadow: none;
    opacity: 0.72;
  }

  .article-body :global(.copy-code-button:hover),
  .article-body :global(.copy-code-button.copied) {
    color: var(--text-primary);
    background: transparent;
    opacity: 1;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3rem 0;
  }

  .article-body :global(h2[id]),
  .article-body :global(h3[id]),
  .article-body :global(h4[id]) {
    scroll-margin-top: 108px;
  }

  .article-body :global(.article-lightbox-target) {
    cursor: zoom-in;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .article-body :global(.article-lightbox-target:hover) {
    transform: translateY(-1px);
    box-shadow: 0 18px 36px rgba(26, 26, 24, 0.1);
  }

  .post-pagination,
  .related-posts {
    margin-top: 3rem;
    border-top: 1px solid var(--border);
    padding-top: 1.5rem;
  }

  .post-pagination {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .pagination-link,
  .related-card {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg-surface);
    padding: 16px;
    text-decoration: none;
  }

  .pagination-link span,
  .related-card span {
    display: block;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  .pagination-link strong,
  .related-card strong {
    display: block;
    font-family: var(--font-display);
    line-height: 1.45;
  }

  .pagination-link.align-right {
    text-align: right;
  }

  .pagination-link.empty {
    visibility: hidden;
  }

  .section-meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .section-meta h2 {
    margin: 0;
  }

  .back-top {
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-top:hover {
    color: var(--text-primary);
  }

  .related-list {
    display: grid;
    gap: 12px;
  }

  .image-lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: grid;
    place-items: center;
    padding: 32px;
    background: rgba(23, 22, 20, 0.72);
    backdrop-filter: blur(14px);
  }

  .image-lightbox[hidden] {
    display: none;
  }

  .lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: white;
    padding: 8px 14px;
    font: inherit;
    cursor: pointer;
  }

  .lightbox-image {
    max-width: min(1200px, calc(100vw - 96px));
    max-height: calc(100vh - 140px);
    border-radius: 14px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
  }

  .lightbox-caption {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    margin: 0;
    max-width: min(760px, calc(100vw - 64px));
    color: rgba(255, 255, 255, 0.86);
    text-align: center;
  }

  @media (max-width: 1280px) {
    :global(main) {
      max-width: var(--container-home);
    }

    .article-layout.with-toc {
      max-width: 1040px;
      display: block;
    }

    .toc-sidebar {
      position: static;
      max-height: none;
      overflow: visible;
      padding-right: 0;
      transform: none;
    }

    .article-toc {
      margin-top: 0;
      margin-bottom: 26px;
    }

    .reading-status {
      top: 16px;
      right: 16px;
    }
  }

  @media (max-width: 720px) {
    .article-header {
      padding: 40px 0 30px;
      margin-bottom: 30px;
    }

    .article-title {
      font-size: 1.75rem;
    }

    .post-pagination {
      grid-template-columns: 1fr;
    }

    .reading-status {
      top: auto;
      right: 12px;
      bottom: 16px;
      min-width: 64px;
      padding: 6px 10px;
    }

    .article-body :global(pre.enhanced-code) {
      padding: 28px 16px 16px;
    }

    .image-lightbox {
      padding: 18px;
    }

    .lightbox-image {
      max-width: calc(100vw - 36px);
      max-height: calc(100vh - 160px);
    }
  }
</style>
