---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, withBase } from "../consts";
import { switchLocalePath, type Locale } from "../i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, locale = "zh" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const faviconHref = withBase("/favicon.svg");
const zhAlternate = new URL(switchLocalePath(Astro.url.pathname, "zh"), Astro.site);
const enAlternate = new URL(switchLocalePath(Astro.url.pathname, "en"), Astro.site);
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..900&display=swap"
    />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="zh-CN" href={zhAlternate.toString()} />
    <link rel="alternate" hreflang="en" href={enAlternate.toString()} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <Header locale={locale} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

<style>
  .page-shell {
    min-height: 100vh;
  }
</style>
