---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, withBase } from "../consts";
import { switchLocalePath, type Locale } from "../i18n";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  locale?: Locale;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  ogImage = "/avatar.jpg",
  ogType = "website",
  locale = "zh",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const faviconHref = withBase("/favicon.svg");
const zhAlternate = new URL(switchLocalePath(Astro.url.pathname, "zh"), Astro.site);
const enAlternate = new URL(switchLocalePath(Astro.url.pathname, "en"), Astro.site);
const ogLocale = locale === "zh" ? "zh_CN" : "en_US";
const ogLocaleAlternate = locale === "zh" ? "en_US" : "zh_CN";
const ogImageHref = /^https?:\/\//i.test(ogImage) ? ogImage : withBase(ogImage.startsWith("/") ? ogImage : `/${ogImage}`);
const ogImageUrl = new URL(ogImageHref, Astro.site).toString();
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..900&display=swap"
    />
    <link rel="canonical" href={canonical.toString()} />
    <link rel="alternate" hreflang="zh-CN" href={zhAlternate.toString()} />
    <link rel="alternate" hreflang="en" href={enAlternate.toString()} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <div class="page-shell">
      <Header locale={locale} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>

<style>
  .page-shell {
    min-height: 100vh;
  }
</style>
