---
import { withBase } from "../consts";
import { type Locale } from "../i18n";

interface Props {
  locale: Locale;
  posts: unknown[];
}

const { locale } = Astro.props;
const searchSource = withBase(locale === "en" ? "/en/search-index.json" : "/search-index.json");
const copy = locale === "zh"
  ? {
      label: "搜索文章",
      placeholder: "输入标题、关键词或标签",
      hint: "例如: Astro / GitHub / 教程",
      empty: "没有匹配结果",
    }
  : {
      label: "Search posts",
      placeholder: "Type title, keyword, or tag",
      hint: "Try: Astro / GitHub / tutorial",
      empty: "No matching posts",
    };

---

<section class="search-panel" data-search-widget data-search-max="8" data-search-source={searchSource}>
  <label class="search-label" for={`search-${locale}`}>{copy.label}</label>
  <input
    id={`search-${locale}`}
    class="search-input"
    type="search"
    placeholder={copy.placeholder}
    autocomplete="off"
    data-search-input
  />
  <p class="search-hint" data-search-hint>{copy.hint}</p>
  <p class="search-empty" data-search-empty hidden>{copy.empty}</p>
  <ul class="search-results" data-search-results></ul>
</section>

<script>
  import { initSearchWidgets } from "../scripts/search-widgets";

  document.addEventListener("astro:page-load", () => {
    initSearchWidgets();
  });
</script>

<style>
  .search-panel {
    margin-bottom: 1.25rem;
  }

  .search-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-family: var(--font-display);
  }

  .search-input {
    width: 100%;
    height: 42px;
    border: 1px solid var(--border);
    background: var(--bg-surface);
    color: var(--text-primary);
    padding: 0 12px;
    font: inherit;
    outline: none;
  }

  .search-input:focus {
    border-color: var(--border-hover);
  }

  .search-hint,
  .search-empty {
    margin: 8px 0 0;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .search-results {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .search-results :global(li) {
    list-style: none;
  }

  .search-results :global(li a) {
    display: block;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text-secondary);
    text-decoration: none;
  }

  .search-results :global(li a:hover),
  .search-results :global(li.active a) {
    background: var(--bg-hover);
    color: var(--text-primary);
    text-decoration: none;
  }

  .search-results :global(li a strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .search-results :global(li a span) {
    font-size: 0.82rem;
    color: var(--text-secondary);
  }

  .search-results :global(mark) {
    background: var(--accent-light);
    color: var(--text-primary);
  }
</style>
