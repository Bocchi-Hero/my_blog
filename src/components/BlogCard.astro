---
import FormattedDate from "./FormattedDate.astro";
import { slugifyTag } from "../content-utils";
import { localePath, type Locale } from "../i18n";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  url: string;
  locale?: Locale;
}

const { title, description, pubDate, tags = [], url, locale = "zh" } = Astro.props;
---

<article class="post-item">
  <a href={url} class="post-link">
    <h3 class="post-title">{title}</h3>
    <p class="post-date"><FormattedDate date={pubDate} locale={locale} /></p>
    <p class="post-desc">{description}</p>
  </a>
  {tags.length > 0 && (
    <div class="post-tags" aria-label={locale === "zh" ? "文章标签" : "Post tags"}>
      {tags.map((tag) => (
        <a href={localePath(locale, `/tags/${slugifyTag(tag)}/`)} class="tag">{tag}</a>
      ))}
    </div>
  )}
</article>

<style>
  .post-item {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    text-decoration: none;
  }

  .post-item:hover {
    background: var(--bg-hover);
    margin: 0 -12px;
  }

  .post-item:hover {
    padding-left: 12px;
    padding-right: 12px;
  }

  .post-link:hover {
    text-decoration: none;
  }

  .post-title {
    font-size: 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: 0;
  }

  .post-date {
    font-size: 0.8rem;
    color: var(--text-muted);
    white-space: nowrap;
    margin: 0 0 0 24px;
    font-variant-numeric: tabular-nums;
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin: 4px 0 0;
    line-height: 1.5;
    grid-column: 1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }

  .post-tags a {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .post-link {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .post-date {
      margin-left: 0;
      margin-top: 2px;
    }
  }
</style>
