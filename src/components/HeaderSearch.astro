---
import { withBase } from "../consts";
import { type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const searchSource = withBase(locale === "en" ? "/en/search-index.json" : "/search-index.json");

const copy = locale === "zh"
  ? {
      label: "搜索文章",
      placeholder: "搜索标题、摘要或标签",
      empty: "没有匹配结果",
    }
  : {
      label: "Search posts",
      placeholder: "Search titles, summaries, or tags",
      empty: "No results",
    };

---

<div
  class="header-search"
  data-search-widget
  data-search-max="6"
  data-search-focus="true"
  data-search-outside-close="true"
  data-search-escape-close="true"
  data-search-source={searchSource}
>
  <label class="sr-only" for={`header-search-${locale}`}>{copy.label}</label>
  <input
    id={`header-search-${locale}`}
    class="header-search-input"
    type="search"
    placeholder={copy.placeholder}
    autocomplete="off"
    data-search-input
  />
  <ul class="header-search-results" data-search-results hidden></ul>
  <p class="header-search-empty" data-search-empty hidden>{copy.empty}</p>
</div>

<script>
  import { initSearchWidgets } from "../scripts/search-widgets";

  document.addEventListener("astro:page-load", () => {
    initSearchWidgets();
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header-search {
    position: relative;
    width: min(280px, 42vw);
    min-width: 180px;
  }

  .header-search-input {
    width: 100%;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.86rem;
    padding: 0 14px;
    outline: none;
  }

  .header-search-input:focus {
    border-color: var(--border-hover);
  }

  .header-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 8px 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-surface);
    z-index: 20;
    max-height: 320px;
    overflow-y: auto;
  }

  .header-search-results :global(li) {
    list-style: none;
  }

  .header-search-results :global(li a) {
    display: block;
    padding: 8px 10px;
    text-decoration: none;
  }

  .header-search-results :global(li a:hover),
  .header-search-results :global(li.active a) {
    background: var(--bg-hover);
    text-decoration: none;
  }

  .header-search-results :global(li strong) {
    display: block;
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .header-search-results :global(li span) {
    display: block;
    margin-top: 1px;
    font-size: 0.76rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .header-search-results :global(mark) {
    background: var(--accent-light);
    color: var(--text-primary);
  }

  .header-search-empty {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    margin: 0;
    padding: 8px 10px;
    font-size: 0.78rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-surface);
    z-index: 20;
  }

  @media (max-width: 720px) {
    .header-search {
      width: 100%;
      min-width: 0;
    }
  }
</style>
