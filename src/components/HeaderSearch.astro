---
import { getCollection } from "astro:content";
import { getLocalizedPostDescription, getLocalizedPostTags, getLocalizedPostTitle } from "../content-utils";
import { localePath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const copy = locale === "zh"
  ? {
      label: "搜索文章",
      placeholder: "搜索文章",
      empty: "没有匹配结果",
    }
  : {
      label: "Search posts",
      placeholder: "Search posts",
      empty: "No results",
    };

const searchItems = posts.map((post) => {
  const title = getLocalizedPostTitle(post, locale);
  const description = getLocalizedPostDescription(post, locale);
  const tags = getLocalizedPostTags(post, locale);
  return {
    title,
    description,
    url: localePath(locale, `/blog/${post.id}/`),
    keywords: `${title} ${description} ${tags.join(" ")}`.toLowerCase(),
  };
});
---

<div class="header-search" data-header-search>
  <label class="sr-only" for={`header-search-${locale}`}>{copy.label}</label>
  <input
    id={`header-search-${locale}`}
    class="header-search-input"
    type="search"
    placeholder={copy.placeholder}
    autocomplete="off"
    data-search-input
  />
  <ul class="header-search-results" data-search-results hidden>
    {searchItems.map((item) => (
      <li data-search-item data-keywords={item.keywords} hidden>
        <a href={item.url}>
          <strong>{item.title}</strong>
          <span>{item.description}</span>
        </a>
      </li>
    ))}
    <li class="header-search-empty" data-search-empty hidden>{copy.empty}</li>
  </ul>
</div>

<script is:inline>
  const searchRoots = document.querySelectorAll("[data-header-search]");
  searchRoots.forEach((root) => {
    const input = root.querySelector("[data-search-input]");
    const results = root.querySelector("[data-search-results]");
    const items = Array.from(root.querySelectorAll("[data-search-item]"));
    const empty = root.querySelector("[data-search-empty]");
    if (!input || !results || !items.length || !empty) return;

    const update = () => {
      const query = input.value.trim().toLowerCase();
      const hasQuery = query.length > 0;
      let shown = 0;
      items.forEach((item) => {
        const text = item.dataset.keywords || "";
        const matched = hasQuery && text.includes(query);
        const visible = matched && shown < 6;
        item.hidden = !visible;
        if (visible) shown += 1;
      });
      empty.hidden = !hasQuery || shown > 0;
      results.hidden = !hasQuery;
    };

    input.addEventListener("input", update);
    input.addEventListener("focus", update);
    document.addEventListener("click", (event) => {
      if (!root.contains(event.target)) {
        results.hidden = true;
      }
    });
    input.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        results.hidden = true;
        input.blur();
      }
    });
  });
</script>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .header-search {
    position: relative;
    width: min(280px, 42vw);
    min-width: 180px;
  }

  .header-search-input {
    width: 100%;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-surface);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.86rem;
    padding: 0 14px;
    outline: none;
  }

  .header-search-input:focus {
    border-color: var(--border-hover);
  }

  .header-search-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    list-style: none;
    margin: 0;
    padding: 8px 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg-surface);
    z-index: 20;
    max-height: 320px;
    overflow-y: auto;
  }

  .header-search-results li a {
    display: block;
    padding: 8px 10px;
    text-decoration: none;
  }

  .header-search-results li a:hover {
    background: var(--bg-hover);
    text-decoration: none;
  }

  .header-search-results li strong {
    display: block;
    font-family: var(--font-display);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .header-search-results li span {
    display: block;
    margin-top: 1px;
    font-size: 0.76rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .header-search-empty {
    padding: 8px 10px;
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .header-search {
      width: 100%;
      min-width: 0;
    }
  }
</style>
