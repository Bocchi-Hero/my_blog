---
import { sharedCopy, type Locale } from "../i18n";
import { AUTHOR_NAME, BILIBILI_URL, GITHUB_URL } from "../consts";

interface Props {
  locale?: Locale;
}

const today = new Date();
const { locale = "zh" } = Astro.props;
const copy = sharedCopy[locale];
---

<footer>
  <p>© {today.getFullYear()} {AUTHOR_NAME}</p>
  <p class="note">
    {copy.footerNote}
    <span class="dot">·</span>
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span class="dot">·</span>
    <a href={BILIBILI_URL} target="_blank" rel="noopener noreferrer">Bilibili</a>
  </p>
</footer>

<style>
  footer {
    max-width: var(--container-home);
    margin: 80px auto 0;
    padding: 32px 24px;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.7rem 1rem;
    flex-wrap: wrap;
  }

  footer p {
    margin: 0;
  }

  .note {
    text-align: right;
  }

  .note a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .note a:hover {
    color: var(--text-primary);
    text-decoration: none;
  }

  .dot {
    margin: 0 0.35rem;
  }

  @media (max-width: 720px) {
    .note {
      text-align: left;
    }
  }
</style>
